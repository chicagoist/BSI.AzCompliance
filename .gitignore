# BSI-AzCompliance .gitignore

# BSI OSCAL catalog cache (auto-downloaded copies — catalog in repo is the committed version)
# The committed Grundschutz++-catalog.json in repo is the source of truth.
# Running with -Sync re-downloads and must not overwrite committed file.
Data/cache/*.tmp
Data/cache/*.download
Data/cache/*.bak

# User-specific configuration (contains Azure resource names)
config.ps1
*.config.ps1

# Generated reports
reports/
*.sarif
*.html
*.xml

# PowerShell
*.ps1xml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
*.nupkg
